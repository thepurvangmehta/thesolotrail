<div class="hero">
  <div class="hero-bg" style="background-image:url('{{ trek.heroImage }}')"></div>
  {% if trek.imageCredit %}<span class="hero-credit">{{ trek.imageCredit }}</span>{% endif %}
  <div class="hero-content">
    <div class="hero-eyebrow">
      <span class="eyebrow-flag">{{ trek.country | countryFlag }} {{ trek.country }}</span>
      <span class="eyebrow-sep">·</span>
      <span class="eyebrow-region">{{ trek.region }}</span>
    </div>
    <h1>{{ trek.name }}</h1>
    <p class="hero-sub">{{ trek.tagline }}</p>
    {% if trek.lastVerified %}<p class="last-updated">Last verified: <time datetime="{{ trek.lastVerified }}">{{ trek.lastVerified }}</time></p>{% endif %}
    <div class="hero-tags">
      <span class="htag accent">Solo-friendly</span>
      {% if trek.maxAltitudeM %}<span class="htag">{{ trek.maxAltitudeM | commaNum }}m</span>{% endif %}
      <span class="htag">{{ trek.duration.min }}{% if trek.duration.max != trek.duration.min %}–{{ trek.duration.max }}{% endif %} day{% if trek.duration.max > 1 %}s{% endif %}</span>
      <span class="htag diff-{{ trek.difficulty | diffClass }}">{{ trek.difficulty | capitalize }}</span>
      {% if trek.category %}<span class="htag">{{ trek.category | replace("-", " ") | capitalize }} trek</span>{% endif %}
    </div>
  </div>
</div>

<div class="stats-bar">
  {% if trek.maxAltitudeM %}<div class="stat-item"><span class="stat-label">Max Altitude</span><span class="stat-value">{{ trek.maxAltitudeM | commaNum }}m</span><span class="stat-sub">{{ trek.name }}</span></div>{% endif %}
  <div class="stat-item"><span class="stat-label">Duration</span><span class="stat-value">{{ trek.duration.min }}{% if trek.duration.max != trek.duration.min %}–{{ trek.duration.max }}{% endif %} day{% if trek.duration.max > 1 %}s{% endif %}</span><span class="stat-sub">From {{ trek.nearestCity }}</span></div>
  {% if trek.totalDistanceKm %}<div class="stat-item"><span class="stat-label">Distance</span><span class="stat-value">~{{ trek.totalDistanceKm }} km</span><span class="stat-sub">{% if trek.itinerary and trek.itinerary.length %}Round trip{% else %}One-way{% endif %}</span></div>{% endif %}
  <div class="stat-item"><span class="stat-label">Difficulty</span><span class="stat-value">{{ trek.difficulty | capitalize }}</span><span class="stat-sub">&nbsp;</span></div>
  <div class="stat-item"><span class="stat-label">Guide Required</span><span class="stat-value">{{ "Yes" if trek.guideRequired else "No" }}</span><span class="stat-sub">&nbsp;</span></div>
  <div class="stat-item"><span class="stat-label">Trailhead</span><span class="stat-value">{{ trek.trailhead }}</span><span class="stat-sub">&nbsp;</span></div>
</div>

{% if trek.gallery and trek.gallery.length %}
<div class="gallery-strip">
  {% for g in trek.gallery %}
  <figure class="gallery-img">
    <img src="{{ g.image }}" alt="{{ g.alt }}" loading="lazy" width="800" height="450">
    {% if g.credit %}<figcaption class="gallery-credit">{{ g.credit }}</figcaption>{% endif %}
  </figure>
  {% endfor %}
</div>
{% endif %}

{# Two-column layout: left main content + 320px sidebar.
   `<main id="main-content">` is opened in base.njk — DO NOT open another <main> here.
   The `.page-body` grid must contain exactly two children:
   `.page-body-inner` (left column) and `<aside class="sidebar">` (right column).
   A stray </main> here will silently break the grid (was a real bug). #}
<div class="page-body">
  <div class="page-body-inner">
    <div class="breadcrumb">
      <a href="/">Home</a><span class="breadcrumb-sep">›</span>
      <a href="/trails/">Trails</a><span class="breadcrumb-sep">›</span>
      <a href="/trails/#{{ trek.region | lower | replace(' ', '-') }}">{{ trek.region }}</a><span class="breadcrumb-sep">›</span>
      <span>{{ trek.name }}</span>
    </div>

    <div class="tabs" role="tablist" aria-label="Trek information">
      <button class="tab active" onclick="switchTab('overview', this)" onkeydown="tabKeydown(event, this)" role="tab" id="tab-overview" aria-controls="panel-overview" aria-selected="true" tabindex="0">Overview</button>
      <button class="tab" onclick="switchTab('route', this)" onkeydown="tabKeydown(event, this)" role="tab" id="tab-route" aria-controls="panel-route" aria-selected="false" tabindex="-1">{% if trek.itinerary and trek.itinerary.length %}Itinerary{% else %}Route{% endif %}</button>
      <button class="tab" onclick="switchTab('reach', this)" onkeydown="tabKeydown(event, this)" role="tab" id="tab-reach" aria-controls="panel-reach" aria-selected="false" tabindex="-1">How to Reach</button>
      <button class="tab" onclick="switchTab('costs', this)" onkeydown="tabKeydown(event, this)" role="tab" id="tab-costs" aria-controls="panel-costs" aria-selected="false" tabindex="-1">Costs</button>
      <button class="tab" onclick="switchTab('safety', this)" onkeydown="tabKeydown(event, this)" role="tab" id="tab-safety" aria-controls="panel-safety" aria-selected="false" tabindex="-1">Safety</button>
      <button class="tab" onclick="switchTab('packing', this)" onkeydown="tabKeydown(event, this)" role="tab" id="tab-packing" aria-controls="panel-packing" aria-selected="false" tabindex="-1">Packing</button>
    </div>

    <!-- OVERVIEW -->
    <div class="tab-panel active" id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0">
      <h2 class="section-heading">About this trek</h2>
      {% if trek.highlights and trek.highlights.length %}
      <div class="highlights-box">
        <div class="highlights-title">Quick read</div>
        <ul class="highlights-list">
          {% for h in trek.highlights %}<li>{{ h }}</li>{% endfor %}
        </ul>
      </div>
      {% endif %}
      <p class="section-intro">{{ trek.tagline }}</p>
      <div class="overview-grid">
        <div class="overview-card">
          <div class="oc-label">Trailhead</div>
          <div class="oc-value"><strong>{{ trek.trailhead }}</strong><br>Nearest city: {{ trek.nearestCity }}</div>
        </div>
        <div class="overview-card">
          <div class="oc-label">Stats</div>
          <div class="oc-value">
            {% if trek.totalDistanceKm %}{{ trek.totalDistanceKm }} km{% endif %}{% if trek.elevationGainM %} · {{ trek.elevationGainM | commaNum }}m elevation gain{% endif %}<br>
            {{ trek.duration.min }}{% if trek.duration.max != trek.duration.min %}–{{ trek.duration.max }}{% endif %} day{% if trek.duration.max > 1 %}s{% endif %} · {{ trek.difficulty | capitalize }}
          </div>
        </div>
        <div class="overview-card full">
          <div class="oc-label">Best time to go</div>
          <div class="best-time-grid">
            {% for s in trek.seasons %}
            <div class="bts">{{ s.label }}<span>{{ s.sub }}</span></div>
            {% endfor %}
          </div>
          {% if trek.seasonNote %}<p class="data-note">{{ trek.seasonNote }}</p>{% endif %}
        </div>
      </div>
      {% if trek.dataNote %}<p class="data-note">Note: {{ trek.dataNote }}</p>{% endif %}
    </div>

    <!-- ROUTE / ITINERARY -->
    <div class="tab-panel" id="panel-route" role="tabpanel" aria-labelledby="tab-route" tabindex="0">
      {% if trek.itinerary and trek.itinerary.length %}
        <h2 class="section-heading">Itinerary</h2>
        <p class="section-intro">Day-by-day route. Tap a day to expand.</p>
        {% for d in trek.itinerary %}
        <div class="day-card" onclick="toggleDay(this)">
          <div class="day-header">
            <div class="day-num{% if loop.last %} summit{% endif %}">{{ d.day }}</div>
            <div class="day-info">
              <div class="day-title">{{ d.from }} → {{ d.to }}</div>
              <div class="day-meta">{{ d.summary }}</div>
            </div>
            <div class="day-stats">
              {% if d.distanceKm %}<span class="dst dist">{{ d.distanceKm }} km</span>{% endif %}
              {% if d.altitudeM %}<span class="dst elev">{{ d.altitudeM | commaNum }}m</span>{% endif %}
            </div>
            <span class="day-chevron">⌄</span>
          </div>
          <div class="day-body">
            <p class="day-desc">{{ d.body }}</p>
            {% if d.tips and d.tips.length %}<div class="day-highlights">{% for t in d.tips %}<span class="dh">{{ t }}</span>{% endfor %}</div>{% endif %}
          </div>
        </div>
        {% endfor %}
      {% elif trek.routeOptions and trek.routeOptions.length %}
        <h2 class="section-heading">Route options</h2>
        <p class="section-intro">Most of these treks have more than one approach — pick the one that matches your fitness and experience.</p>
        {% for r in trek.routeOptions %}
        <div class="route-option">
          <div class="route-option-head">
            <span class="route-option-name">{{ r.name }}</span>
            <div class="route-option-stats">
              <span class="dst diff-{{ r.difficulty | diffClass }}">{{ r.difficulty | capitalize }}</span>
              {% if r.distanceKm %}<span class="dst dist">{{ r.distanceKm }} km</span>{% endif %}
              {% if r.duration %}<span class="dst elev">{{ r.duration }}</span>{% endif %}
            </div>
          </div>
          {% if r.notes %}<p class="route-option-notes">{{ r.notes }}</p>{% endif %}
        </div>
        {% endfor %}
      {% else %}
        <div class="placeholder-box"><strong>Route detail coming soon</strong>We're still documenting the exact route for this trek.</div>
      {% endif %}
    </div>

    <!-- HOW TO REACH -->
    <div class="tab-panel" id="panel-reach" role="tabpanel" aria-labelledby="tab-reach" tabindex="0">
      <h2 class="section-heading">How to reach {{ trek.trailhead }}</h2>
      {% if trek.gettingThere and trek.gettingThere.steps and trek.gettingThere.steps.length %}
        {% if trek.gettingThere.intro %}<p class="section-intro">{{ trek.gettingThere.intro }}</p>{% endif %}
        {% for step in trek.gettingThere.steps %}
        <div class="reach-step">
          <div class="reach-step-num">{{ loop.index }}</div>
          <div class="reach-content"><div class="reach-title">{{ step.title }}</div><div class="reach-desc">{{ step.body }}</div></div>
        </div>
        {% endfor %}
        {% if trek.gettingThere.permitNote %}<div class="alert-box info"><span class="alert-icon">ℹ️</span><span class="alert-text">{{ trek.gettingThere.permitNote }}</span></div>{% endif %}
      {% else %}
        <div class="placeholder-box"><strong>Logistics guide coming soon</strong>Transport options, routes, and booking details for reaching {{ trek.trailhead }} are still being written.</div>
      {% endif %}
    </div>

    <!-- COSTS -->
    <div class="tab-panel" id="panel-costs" role="tabpanel" aria-labelledby="tab-costs" tabindex="0">
      <h2 class="section-heading">What it costs</h2>
      {% if trek.costs and (trek.costs.permits or trek.costs.transport or trek.costs.onTrail or trek.costs.extras) %}
        {% for section in [{k:"permits", t:"Permits"}, {k:"transport", t:"Transport"}, {k:"onTrail", t:"On the trail"}, {k:"extras", t:"Extras"}] %}
          {% set rows = trek.costs[section.k] %}
          {% if rows and rows.length %}
          <div class="cost-section">
            <div class="cost-section-title">{{ section.t }}</div>
            {% for row in rows %}
            {# Indian treks carry researched INR ranges (e.g. "150-250"); these render as-is
               because they're rough local ranges — pushing them through the USD currency
               switcher would invent precision that isn't in the source data.
               Nepal treks carry numeric amountUSD and stay on the data-price path. #}
            <div class="cost-row"><div><div class="cost-item">{{ row.item }}</div>{% if row.note %}<div class="cost-note">{{ row.note }}</div>{% endif %}</div><div class="cost-amount">{% if row.amountINR %}{% if row.amountINR | first in "0123456789~" %}₹{% endif %}{{ row.amountINR }}{% else %}<span data-price="{{ row.amountUSD }}">${{ row.amountUSD }}</span>{% endif %}</div></div>
            {% endfor %}
          </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="placeholder-box"><strong>Cost breakdown coming soon</strong>Real permit, transport, and on-trail costs for this trek are still being researched.</div>
      {% endif %}
    </div>

    <!-- SAFETY -->
    <div class="tab-panel" id="panel-safety" role="tabpanel" aria-labelledby="tab-safety" tabindex="0">
      <h2 class="section-heading">Safety</h2>
      {% if trek.safety and trek.safety.intro %}<p class="section-intro">{{ trek.safety.intro }}</p>{% endif %}
      {% if trek.safety and trek.safety.alerts %}
        {% for a in trek.safety.alerts %}
        <div class="alert-box {{ a.type }}"><span class="alert-icon">{% if a.type == 'danger' %}⚠️{% elif a.type == 'warning' %}⚡{% else %}ℹ️{% endif %}</span><span class="alert-text"><strong>{{ a.title }}</strong>{{ a.body }}</span></div>
        {% endfor %}
      {% endif %}
      {% if trek.safety and trek.safety.cards %}
      <div class="safety-grid">
        {% for c in trek.safety.cards %}
        <div class="safety-card"><div class="safety-card-title">{{ c.title }}</div><div class="safety-card-body"><ul style="padding-left:16px;">{% for it in c.items %}<li>{{ it }}</li>{% endfor %}</ul></div></div>
        {% endfor %}
      </div>
      {% endif %}
      {% if trek.safety and trek.safety.emergencyContacts and trek.safety.emergencyContacts.length %}
      <h3 class="section-heading" style="font-size:18px;margin-top:32px;">Emergency contacts</h3>
      {% for ec in trek.safety.emergencyContacts %}
      <div class="emergency-row"><span class="em-label">{{ ec.label }}</span><span class="em-value">{{ ec.number }}</span></div>
      {% endfor %}
      {% endif %}
      {% if not trek.safety or not trek.safety.intro %}
      <div class="placeholder-box"><strong>Detailed safety notes coming soon</strong></div>
      {% endif %}
    </div>

    <!-- PACKING -->
    <div class="tab-panel" id="panel-packing" role="tabpanel" aria-labelledby="tab-packing" tabindex="0">
      <h2 class="section-heading">Packing list</h2>
      {% if trek.packing and trek.packing.length %}
        {% for cat in trek.packing %}
        <div class="pack-category">
          <div class="pack-cat-title">{{ cat.category }}</div>
          {% for item in cat.items %}
          <label class="pack-item"><input type="checkbox">{{ item.name }}{% if item.amazonLink %}<a href="{{ item.amazonLink }}" class="buy-link" onclick="event.stopPropagation()">Buy</a>{% endif %}</label>
          {% endfor %}
        </div>
        {% endfor %}
      {% else %}
        <div class="placeholder-box"><strong>Packing list coming soon</strong></div>
      {% endif %}
    </div>

    {# Visible FAQ block. Must stay in sync with the FAQPage JSON-LD in trail.njk —
       both render from the same `trek | trekFaqs` filter, so editing one edits both.
       Google requires FAQ answers to be visible on the page, not schema-only. #}
    {% set trekFaqList = trek | trekFaqs %}
    {% if trekFaqList.length %}
    <section class="trek-faq">
      <h2 class="section-heading">{{ trek.shortName or trek.name }} — common questions</h2>
      {% for f in trekFaqList %}
      <details class="trek-faq-item"{% if loop.first %} open{% endif %}>
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {% endfor %}
    </section>
    {% endif %}

    {% set related = relatedTrails(trek) %}
    {% if related and related.length %}
    <section class="related-trails">
      <h2 class="section-heading">Similar solo treks</h2>
      <p class="section-intro">Other routes solo trekkers tend to compare with {{ trek.name }}.</p>
      <div class="related-grid">
        {% for r in related %}
        <a href="/trails/{{ r.id }}/" class="related-card">
          <img src="{{ r.cardImage or r.heroImage }}" alt="{{ r.name }}" loading="lazy" width="400" height="140">
          <div class="related-body">
            <div class="related-name">{{ r.name }}</div>
            <div class="related-meta">{{ r.country | countryFlag }} {{ r.region }} · {{ r.difficulty | capitalize }}</div>
          </div>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}
  </div>

  <aside class="sidebar">
    {% if trek.permits and trek.permits.length %}
    <div class="sidebar-card">
      <div class="sc-head">Permits &amp; fees</div>
      <div class="sc-body">
        {% for p in trek.permits %}
        <div class="permit-row"><div><div class="permit-name">{{ p.name }}</div>{% if p.fullName %}<div class="permit-note">{{ p.fullName }}</div>{% endif %}{% if p.notes %}<div class="permit-note">{{ p.notes }}</div>{% endif %}</div><div class="permit-price">{% if p.priceUSD %}<span data-price="{{ p.priceUSD }}">${{ p.priceUSD }}</span>{% else %}—{% endif %}</div></div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <div class="sidebar-card">
      <div class="sc-head">Best time to visit</div>
      <div class="sc-body">
        {% for s in trek.seasons %}
        <div class="weather-row"><span class="wr-season">{{ s.label }}</span><span class="wr-badge wr-{{ s.badge }}">{{ s.badge | upper }}</span></div>
        {% endfor %}
      </div>
    </div>

    {% if trek.guideProgramActive %}
    {# Stage 0 of the guide-marketplace plan: a real request, routed to email
       since the site is static (no backend, no third-party form account set
       up yet). Honest framing on purpose — this is a manual introduction
       service being piloted with one real contact, not a live booking system
       with a vetted roster. Don't imply more than that's true. #}
    <div class="sidebar-card guide-request-card" id="guide-request">
      <div class="sc-head">Guide for this trek</div>
      <div class="sc-body">
        <p class="guide-request-copy">{{ trek.guideProgramIntro or ("We're piloting a direct introduction to a local guide for " + (trek.shortName or trek.name) + ". This is early — a real person reads every request and replies personally, not an instant booking system." ) }}</p>
        <form class="guide-request-form" id="guide-request-form">
          <label>Your name<input type="text" name="name" required></label>
          <label>Your email<input type="email" name="email" required></label>
          <label>Planned dates<input type="text" name="dates" placeholder="e.g. Oct 12–22, 2026"></label>
          <label>Group size<input type="number" name="groupSize" min="1" value="1"></label>
          <label>Anything else the guide should know<textarea name="message" rows="3" placeholder="Experience level, questions, flexibility on dates…"></textarea></label>
          <button type="submit" class="guide-request-submit">Request an introduction</button>
        </form>
        <p class="guide-request-disclosure">Sends an email to our team — no account, no payment, no commitment. We'll reply personally before anything else happens.</p>
      </div>
    </div>
    {% else %}
    {# Demand-signal test for a future local-guide booking feature — not a
       real product yet. Same visitors, same trek page, but the copy asks a
       specific question ("would you use a guide for THIS trek") instead of
       a generic notify-me, so clicks here are a read on that idea specifically. #}
    <div class="sidebar-card guide-interest-card">
      <div class="sc-head">Solo, but not alone</div>
      <div class="sc-body">
        <p class="guide-interest-copy">We're exploring connecting solo trekkers with a vetted local guide — for a full trek, or just its hardest section.</p>
        <p class="guide-interest-note">Want a guide for {{ trek.shortName or trek.name }}? Join the list and we'll reach out first.</p>
        <div class="waitlist-row">
          <script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="873d1fa4-f97d-445f-917c-6df807bbc186"></script>
        </div>
      </div>
    </div>
    {% endif %}

  </aside>
</div>

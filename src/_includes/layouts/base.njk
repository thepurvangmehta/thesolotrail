<!DOCTYPE html>
<html lang="en">
<head>
<!-- Google Tag Manager -->
{% include "partials/gtm-head.njk" %}
<!-- End Google Tag Manager -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ seoTitle or title }}</title>
<meta name="description" content="{{ seoDescription or description }}">
<meta property="og:title" content="{{ seoTitle or title }}">
<meta property="og:description" content="{{ seoDescription or description }}">
{% if ogImage %}
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="800">
<meta property="og:image:alt" content="{{ seoTitle or title }}">
{% endif %}
<meta property="og:url" content="https://thesolotrail.com{{ page.url }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="The Solo Trail">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seoTitle or title }}">
<meta name="twitter:description" content="{{ seoDescription or description }}">
{% if ogImage %}<meta name="twitter:image" content="{{ ogImage }}">{% endif %}
<meta name="twitter:site" content="@thesolotrail">
<meta name="twitter:creator" content="@thesolotrail">
{# Trail-page freshness meta (rendered on trail pages via the `trek` local from pagination) #}
{% if trek and trek.lastVerified %}<meta property="article:modified_time" content="{{ trek.lastVerified }}">{% endif %}
{% if trek and trek.publishedDate %}<meta property="article:published_time" content="{{ trek.publishedDate }}">{% endif %}
<link rel="canonical" href="https://thesolotrail.com{{ page.url }}">
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/assets/site.webmanifest">
<meta name="theme-color" content="#14161A">
<link rel="preconnect" href="https://commons.wikimedia.org" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Inter-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/InstrumentSerif-latin.woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/tokens.css">
{% block pagecss %}{% endblock %}
{% block jsonld %}{% endblock %}
{% block headExtras %}{% endblock %}
</head>
{# Page context for analytics — read by assets/analytics.js and attached to every
   event, so GA4 can segment by trek/region without extra configuration. #}
<body data-page-type="{{ pageType or ('trail' if trek else 'other') }}"{% if trek %} data-trek-id="{{ trek.id }}" data-trek-region="{{ trek.region }}" data-trek-country="{{ trek.country }}"{% endif %}>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WKH7834H"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

<a href="#main-content" class="skip-link">Skip to content</a>

<header>
{% if not hideNav %}{% include "partials/nav.njk" %}{% endif %}
</header>

<main id="main-content" tabindex="-1">
{% block content %}{% endblock %}
</main>

{% if not hideFooter %}{% include "partials/footer.njk" %}{% endif %}

{% if not hideNav %}
<script>
  var navHamburger = document.getElementById('nav-hamburger');
  var navLinks = document.getElementById('nav-links');
  navHamburger.addEventListener('click', function() {
    var open = navLinks.classList.toggle('open');
    navHamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.addEventListener('click', function(e) {
    if (!e.target.closest('nav')) {
      navLinks.classList.remove('open');
      navHamburger.setAttribute('aria-expanded', 'false');
    }
  });
</script>
{% endif %}
{% block pagejs %}{% endblock %}
<script src="/assets/currency.js"></script>
<script src="/assets/analytics.js" defer></script>
</body>
</html>

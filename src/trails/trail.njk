---
pagination:
  data: trailsList
  size: 1
  alias: trek
permalink: "/trails/{{ trek.id }}/"
eleventyComputed:
  seoTitle: "{{ trek.seoTitle }}"
  seoDescription: "{{ trek.seoDescription }}"
  ogImage: "{{ trek.heroImage }}"
  ogType: article
  navActive: trails
---
{% extends "layouts/base.njk" %}

{% block pagecss %}
{% if trek.status == 'live' %}<link rel="stylesheet" href="/assets/css/trail-live.css">
{% else %}<link rel="stylesheet" href="/assets/css/trail-stub.css">
{% endif %}
{% endblock %}

{% block content %}
{% if trek.status == 'live' %}
  {% include "partials/trail-live-body.njk" %}
{% else %}
  {% include "partials/trail-stub-body.njk" %}
{% endif %}
{% endblock %}

{% block pagejs %}
{% if trek.status == 'live' %}
<script>
  function switchTab(name, btn) {
    document.querySelectorAll('.tab').forEach(function(t) { t.classList.remove('active'); });
    document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById('panel-' + name).classList.add('active');
  }
  function toggleDay(el) { el.classList.toggle('open'); }
  document.querySelectorAll('.pack-item').forEach(function(item) {
    item.addEventListener('click', function() { item.classList.toggle('checked'); });
  });
</script>
{% endif %}
{% endblock %}

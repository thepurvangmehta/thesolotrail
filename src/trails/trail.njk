---
pagination:
  data: trailsList
  size: 1
  alias: trek
permalink: "/trails/{{ trek.id }}/"
eleventyComputed:
  seoTitle: "{{ trek.seoTitle }}"
  seoDescription: "{{ trek.seoDescription }}"
  ogImage: "{{ trek.heroImage }}"
  ogType: article
  navActive: trails
---
{% extends "layouts/base.njk" %}

{% block pagecss %}
{% if trek.status == 'live' %}<link rel="stylesheet" href="/assets/css/trail-live.css">
{% else %}<link rel="stylesheet" href="/assets/css/trail-stub.css">
{% endif %}
{% endblock %}

{% block jsonld %}
{% set trekUrl = "https://thesolotrail.com/trails/" ~ trek.id ~ "/" %}
{% set trekLd = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": trek.name,
  "description": trek.seoDescription,
  "image": trek.heroImage,
  "url": trekUrl,
  "touristType": "Solo travelers",
  "address": {
    "@type": "PostalAddress",
    "addressRegion": trek.region,
    "addressCountry": trek.country
  }
} %}
{% set breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://thesolotrail.com/" },
    { "@type": "ListItem", "position": 2, "name": "Trails", "item": "https://thesolotrail.com/trails/" },
    { "@type": "ListItem", "position": 3, "name": trek.name, "item": trekUrl }
  ]
} %}
{# FAQPage schema only on live trails: the visible FAQ block lives in
   trail-live-body.njk, and Google requires the answers be on-page. Stub pages
   render trail-stub-body.njk with no FAQ, so they must not claim the schema. #}
{% set faqs = (trek | trekFaqs) if trek.status == 'live' else [] %}
{% if faqs.length %}
{% set faqLd = { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [] } %}
{% for f in faqs %}
  {% set _ = faqLd.mainEntity.push({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }) %}
{% endfor %}
{% endif %}
<script type="application/ld+json">{{ trekLd | dump | safe }}</script>
<script type="application/ld+json">{{ breadcrumbLd | dump | safe }}</script>
{% if faqs.length %}<script type="application/ld+json">{{ faqLd | dump | safe }}</script>{% endif %}
{% endblock %}

{% block headExtras %}
<link rel="preload" as="image" href="{{ trek.heroImage }}" fetchpriority="high">
{% endblock %}

{% block content %}
{% if trek.status == 'live' %}
  {% include "partials/trail-live-body.njk" %}
{% else %}
  {% include "partials/trail-stub-body.njk" %}
{% endif %}
{% endblock %}

{% block pagejs %}
{% if trek.status == 'live' %}
<script>
  function switchTab(name, btn) {
    document.querySelectorAll('.tab').forEach(function(t) {
      t.classList.remove('active');
      t.setAttribute('aria-selected', 'false');
      t.tabIndex = -1;
    });
    document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
    btn.classList.add('active');
    btn.setAttribute('aria-selected', 'true');
    btn.tabIndex = 0;
    document.getElementById('panel-' + name).classList.add('active');
  }
  function tabKeydown(e, btn) {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));
    var i = tabs.indexOf(btn);
    var next = null;
    if (e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
    else if (e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
    else if (e.key === 'Home') next = tabs[0];
    else if (e.key === 'End') next = tabs[tabs.length - 1];
    else return;
    e.preventDefault();
    next.focus();
    next.click();
  }
  function toggleDay(el) { el.classList.toggle('open'); }
  document.querySelectorAll('.pack-item').forEach(function(item) {
    item.addEventListener('click', function() { item.classList.toggle('checked'); });
  });
</script>
{% endif %}
{% endblock %}

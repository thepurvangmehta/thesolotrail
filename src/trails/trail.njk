---
pagination:
  data: trailsList
  size: 1
  alias: trek
permalink: "/trails/{{ trek.id }}/"
eleventyComputed:
  seoTitle: "{{ trek.seoTitle }}"
  seoDescription: "{{ trek.seoDescription }}"
  ogImage: "{{ trek.heroImage }}"
  ogType: article
  navActive: trails
---
{% extends "layouts/base.njk" %}

{% block pagecss %}
{% if trek.status == 'live' %}<link rel="stylesheet" href="/assets/css/trail-live.css">
{% else %}<link rel="stylesheet" href="/assets/css/trail-stub.css">
{% endif %}
{% endblock %}

{% block jsonld %}
{% set trekUrl = "https://thesolotrail.com/trails/" ~ trek.id ~ "/" %}
{% set trekLd = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": trek.name,
  "description": trek.seoDescription,
  "image": trek.heroImage,
  "url": trekUrl,
  "touristType": "Solo travelers",
  "address": {
    "@type": "PostalAddress",
    "addressRegion": trek.region,
    "addressCountry": trek.country
  }
} %}
{% set breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://thesolotrail.com/" },
    { "@type": "ListItem", "position": 2, "name": "Trails", "item": "https://thesolotrail.com/trails/" },
    { "@type": "ListItem", "position": 3, "name": trek.name, "item": trekUrl }
  ]
} %}
{# FAQPage schema only on live trails: the visible FAQ block lives in
   trail-live-body.njk, and Google requires the answers be on-page. Stub pages
   render trail-stub-body.njk with no FAQ, so they must not claim the schema. #}
{% set faqs = (trek | trekFaqs) if trek.status == 'live' else [] %}
{% if faqs.length %}
{% set faqLd = { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [] } %}
{% for f in faqs %}
  {% set _ = faqLd.mainEntity.push({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }) %}
{% endfor %}
{% endif %}
<script type="application/ld+json">{{ trekLd | dump | safe }}</script>
<script type="application/ld+json">{{ breadcrumbLd | dump | safe }}</script>
{% if faqs.length %}<script type="application/ld+json">{{ faqLd | dump | safe }}</script>{% endif %}
{% endblock %}

{% block headExtras %}
<link rel="preload" as="image" href="{{ trek.heroImage }}" fetchpriority="high">
{% endblock %}

{% block content %}
{% if trek.status == 'live' %}
  {% include "partials/trail-live-body.njk" %}
{% else %}
  {% include "partials/trail-stub-body.njk" %}
{% endif %}
{% endblock %}

{% block pagejs %}
{% if trek.status == 'live' %}
<script>
  function switchTab(name, btn) {
    document.querySelectorAll('.tab').forEach(function(t) {
      t.classList.remove('active');
      t.setAttribute('aria-selected', 'false');
      t.tabIndex = -1;
    });
    document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
    btn.classList.add('active');
    btn.setAttribute('aria-selected', 'true');
    btn.tabIndex = 0;
    document.getElementById('panel-' + name).classList.add('active');
  }
  function tabKeydown(e, btn) {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));
    var i = tabs.indexOf(btn);
    var next = null;
    if (e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
    else if (e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
    else if (e.key === 'Home') next = tabs[0];
    else if (e.key === 'End') next = tabs[tabs.length - 1];
    else return;
    e.preventDefault();
    next.focus();
    next.click();
  }
  function toggleDay(el) { el.classList.toggle('open'); }
  document.querySelectorAll('.pack-item').forEach(function(item) {
    item.addEventListener('click', function() { item.classList.toggle('checked'); });
  });

  {# Stage 0 of the guide-marketplace plan: submits to a Google Apps Script
     Web App backed by a Sheet the team owns, so every request lands as one
     row in a list to review on our own schedule — not one email per
     submission, and no trekker ever leaves the page. The URL lives in the
     trek's own data file (guideFormSheetUrl); until that's a real deployed
     Apps Script URL, submission fails gracefully into the mailto fallback
     below rather than silently losing the request.

     Content-Type is deliberately 'text/plain' rather than 'application/json':
     Apps Script Web Apps don't answer CORS preflight (OPTIONS) requests, so a
     'application/json' fetch — which triggers a preflight — would be blocked
     by the browser before it ever reached the script. text/plain keeps this a
     CORS-exempt "simple request"; Apps Script still parses the body as JSON
     on the server side via JSON.parse(e.postData.contents).

     mode: 'no-cors' below is likewise deliberate, not an oversight: Apps
     Script's response never carries an Access-Control-Allow-Origin header
     (there's no supported way to add one from ContentService), so a normal
     cors-mode fetch has its response blocked from JS even when the script
     ran and the row was appended — it just looks like a failure. no-cors
     trades away the ability to read the response for a request that
     actually resolves; the Sheet itself is the source of truth for whether
     an entry landed, not this success message. #}
  var guideForm = document.getElementById('guide-request-form');
  var guideResult = document.getElementById('guide-request-result');
  if (guideForm && guideResult) {
    var submitBtn = guideForm.querySelector('.guide-request-submit');
    var submitLabel = guideForm.querySelector('.guide-request-submit-label');
    var fallbackMailto = function(f) {
      var subject = 'Guide request — {{ trek.name }} (' + f.name.value + ')';
      var body = 'Trek: {{ trek.name }}\nName: ' + f.name.value + '\nEmail: ' + f.email.value +
        '\nPlanned dates: ' + (f.dates.value || 'Not specified') + '\nGroup size: ' + f.groupSize.value +
        '\n\nMessage:\n' + (f.message.value || '(none)');
      return 'mailto:thepurvangmehta@gmail.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    };
    guideForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var f = guideForm;
      if (f.botcheck.checked) return; // honeypot tripped — silently drop, likely a bot
      var sheetUrl = guideForm.dataset.sheetUrl;
      guideResult.hidden = true;
      guideResult.className = 'guide-request-result';
      if (!sheetUrl || sheetUrl === 'PENDING_SHEET_URL') {
        // Form isn't wired to a real deployment yet — fail open to mailto
        // rather than pretend the request went somewhere it didn't.
        window.location.href = fallbackMailto(f);
        return;
      }
      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending…';
      fetch(sheetUrl, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({
          trek: '{{ trek.name }}',
          name: f.name.value,
          email: f.email.value,
          dates: f.dates.value || 'Not specified',
          group_size: f.groupSize.value,
          message: f.message.value || '(none)'
        })
      }).then(function() {
        // no-cors gives back an opaque response — reaching here means the
        // request went out and didn't error at the network level, which is
        // all we can know client-side. Good enough for a fire-and-forget
        // lead form backed by a Sheet we can just go look at.
        guideForm.hidden = true;
        guideResult.textContent = "Thanks — we've got your request and will reply personally within a couple of days.";
        guideResult.className = 'guide-request-result ok';
        guideResult.hidden = false;
        if (window.dataLayer) window.dataLayer.push({ event: 'guide_request_submit', trek_id: '{{ trek.id }}' });
      }).catch(function() {
        submitBtn.disabled = false;
        submitLabel.textContent = 'Request an introduction';
        guideResult.innerHTML = 'Something went wrong sending that. <a href="' + fallbackMailto(f) + '">Email us directly instead</a>.';
        guideResult.className = 'guide-request-result err';
        guideResult.hidden = false;
      });
    });
  }
</script>
{% endif %}
{% endblock %}

---
seoTitle: The Solo Trail — Independent Trek Guides for Nepal and India
seoDescription: Practical, honest trek guides for solo travellers across Nepal and Maharashtra, India. Real costs, real safety notes, no group-tour assumptions.
ogImage: https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1200&q=80
---
{% extends "layouts/base.njk" %}

{% block pagecss %}<link rel="stylesheet" href="/assets/css/home.css">{% endblock %}

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "The Solo Trail",
  "url": "https://thesolotrail.com/",
  "description": "Independent trek guides for solo travellers — Nepal and India."
}
</script>
{% endblock %}

{% block content %}

<section class="hero">
  <canvas id="topo-canvas" aria-hidden="true"></canvas>
  <div class="hero-content">
    <div class="hero-eyebrow">Independent trek guides</div>
    <h1 class="hero-headline">Written for the<br>person going alone.</h1>
    <p class="hero-sub">No group itineraries. No upsells. Detailed, practical guides for solo trekkers — the information you need to do it properly on your own. {{ trailsList.length }} trails and counting, across Nepal and India.</p>
  </div>
</section>
<div class="hero-divider"></div>

<!-- MAHARASHTRA LAUNCH -->
<div class="section-wrap" style="padding-bottom:0;">
  <a href="/trails/#maharashtra" class="mh-banner">
    <div class="mh-banner-text">
      <div class="mh-banner-eyebrow">Just launched</div>
      <h2>Maharashtra is live — {{ collections.trailsMaharashtra.length }} treks, fully mapped</h2>
      <p>Sahyadri hill forts, jungle trails, the state's highest peak, monsoon waterfalls, and Konkan sea forts. Our first fully-covered Indian state.</p>
    </div>
    <div class="mh-banner-stats">
      <div class="mh-stat"><div class="mh-stat-num">{{ collections.trailsMaharashtra.length }}</div><div class="mh-stat-label">Treks</div></div>
      <div class="mh-stat"><div class="mh-stat-num">5</div><div class="mh-stat-label">Categories</div></div>
    </div>
  </a>
</div>

<!-- FEATURED TRAIL -->
<div class="section-wrap">
  <div class="section-eyebrow">Featured trail</div>
  <a href="/trails/annapurna-base-camp/" class="featured-card">
    <div class="fc-image">
      <img
        src="https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=1600&q=90"
        alt="Annapurna Base Camp — Himalayan mountain amphitheatre"
        loading="eager"
        fetchpriority="high"
        width="800" height="440"
      >
      <div class="fc-image-overlay"></div>
      <div class="fc-region-badge">🇳🇵 Nepal</div>
    </div>
    <div class="fc-body">
      <div class="fc-country">Annapurna Region</div>
      <h2 class="fc-title">Annapurna<br>Base Camp</h2>
      <p class="fc-desc">A high-altitude amphitheatre at 4,130m, ringed by eight-thousanders. Solo-doable, deeply rewarding — and one of the few Himalayan classics with no mandatory guide requirement.</p>
      <div class="fc-stats">
        <span class="fcs hl"><span data-price="400-800">$400–$800</span> all-in</span>
        <span class="fcs">7–10 days</span>
        <span class="fcs">~110 km round trip</span>
        <span class="fcs">No guide required</span>
      </div>
      <span class="fc-cta">Read the full guide →</span>
    </div>
  </a>
</div>

<!-- COMING SOON -->
<div class="coming-section">
  <div class="section-wrap">
    <div class="section-eyebrow">On the list</div>
    <div class="coming-grid">
      {% for t in trailsList %}{% if t.status == "planned" %}
      <a href="/trails/{{ t.id }}/" class="coming-card">
        <div class="coming-badge">Coming soon</div>
        <div class="coming-region">{{ t.country | countryFlag }} {{ t.region }}</div>
        <div class="coming-title">{{ t.name }}</div>
        <p class="coming-desc">{{ t.tagline }}</p>
      </a>
      {% endif %}{% endfor %}
      {% set nextState = stateStubs[0] %}
      <a href="/trails/#more-states" class="coming-card">
        <div class="coming-badge">Coming soon</div>
        <div class="coming-region">🇮🇳 India</div>
        <div class="coming-title">{{ nextState.name }}</div>
        <p class="coming-desc">{{ nextState.blurb }}</p>
      </a>
    </div>
  </div>
</div>

<!-- MANIFESTO -->
<div class="manifesto">
  <div class="manifesto-inner">
    <p class="manifesto-quote">"The mountains have a way of dealing with overconfidence."</p>
    <p class="manifesto-attr">— Hermann Buhl, Nanga Parbat, 1953</p>
  </div>
</div>

{% endblock %}

{% block pagejs %}
<script>
  (function () {
    const canvas  = document.getElementById('topo-canvas');
    const section = canvas.parentElement;

    function draw() {
      const W = section.offsetWidth;
      const H = section.offsetHeight;
      canvas.width  = W;
      canvas.height = H;
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = 'rgba(26,58,42,0.055)';
      ctx.lineWidth   = 1;
      const cx = W * 0.78;
      const cy = H * 0.48;
      for (let i = 0; i < 20; i++) {
        const rx = 70 + i * 54;
        const ry = 36 + i * 26;
        ctx.beginPath();
        for (let s = 0; s <= 64; s++) {
          const a = (s / 64) * Math.PI * 2;
          const j = 1 + 0.045 * Math.sin(a * 3 + i * 0.8) + 0.022 * Math.cos(a * 7 + i * 1.3);
          const x = cx + i * 3 + Math.cos(a) * rx * j;
          const y = cy + i * 1.5 + Math.sin(a) * ry * j;
          s === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.closePath();
        ctx.stroke();
      }
    }

    draw();
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      new ResizeObserver(draw).observe(section);
    }
  })();
</script>
{% endblock %}
